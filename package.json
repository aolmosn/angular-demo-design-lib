{
  "name": "angular-test-design-lib",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "npm run purge-styles && ng build",
    "build:dev": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "purge-styles": "node node_modules/@aolmosn/styles/bin/purge.mjs --src ./src --out ./src/styles-purged.css",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@aolmosn/angular": "^0.1.2",
    "@aolmosn/core": "^0.1.0",
    "@aolmosn/styles": "^0.1.3",
    "@aolmosn/tokens": "^0.1.2",
    "@aolmosn/web-components": "^0.1.3",
    "lit": "^3.3.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler": "^22.1.6",
    "@angular/compiler-cli": "^22.1.6",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.1.1",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
